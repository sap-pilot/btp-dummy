{
    "xsappname": "btp-dummy",
    "tenant-mode": "dedicated",
    "description": "BTP dummy app for testing and troubleshooting issues",
    "scopes": [
        {
            "name": "uaa.user",
            "description": "UAA"
        },
        {
            "name": "$XSAPPNAME.admin",
            "description": "BTP Dummy Admin"
        }
    ],
    "attributes": [
        {
            "name": "BusinessUnits",
            "description": "Authorized Business Units",
            "valueType": "string"
        }
    ],
    "role-templates": [
        {
            "name": "Token_Exchange",
            "description": "UAA",
            "scope-references": [
                "uaa.user"
            ]
        },
        {
            "name": "BTP_Dummy_Admin",
            "description": "BTP Dummy Admin",
            "scope-references": [
                "$XSAPPNAME.admin"
            ],
            "attribute-references": [
                {
                    "name": "BusinessUnits"
                }
            ]
        }
    ],
    "oauth2-configuration": {
        "redirect-uris": [
            "https://*.cfapps.us10.hana.ondemand.com/**",
            "https://*.cfapps.us20.hana.ondemand.com/**",
            "https://*.cfapps.eu10.hana.ondemand.com/**"
        ]
    }
}